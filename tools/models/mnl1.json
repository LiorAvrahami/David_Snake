  },
  "split": "the games listed in test_games were held out (not trained on): --holdout 0.3 --seed 1 --never-test DavidSnake_InputLab_v1.10.63_2026-10-03_235821.txt,DavidSnake_InputLab_v1.13.66_2026-10-04_003849.txt,zDavidSnake_InputLab_v1.13.66_2026-10-08_130959.txt in tools/simlearn.py split()",
  "objective": {
   "windows": "one per gesture start: finger speed rising from under 60 to over 150 dp/s with 10 dp of travel, or a turn of 60 degrees or more while moving (speed over 40 ms); a gesture starting less than 250 ms after a window's start belongs to that window",
   "input": "the finger samples of the first 250 ms from the window's start; then, if David turned, one more turn before his next regular step after the latest turn, which ends the input",
   "run": "after the input David goes straight until he eats the harp or dies",
   "harp": "+1 for eating the harp, whenever it happens (only the first); the run ends there",
   "death": "-0.5 times exp(-(s - 1) / decay), s = steps from the window start to the death, decay by cause; a spear hitting David from the side (flying across the direction of his last step) costs nothing",
   "death_decay_steps": {
    "hit the wall": 1.0,
    "speared": 3.7,
    "ran into the tail": 1.0
   },
   "spears": "recorded throws aimed before the window started (throw tick <= start + 18)"
